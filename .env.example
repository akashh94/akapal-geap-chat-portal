# HS256 signing key for the session cookie. Required. 32+ random characters.
SESSION_SECRET=change-me-to-a-long-random-string

# Optional. Defaults to ./data/app.db
DATABASE_PATH=./data/app.db

# Set to "true" only when served over HTTPS. Keep "false" on localhost.
COOKIE_SECURE=false

# Base URL of the BFF service that owns the agent session mapping.
BFF_URL=http://localhost:4000
