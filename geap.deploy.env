# Deployment configuration, sourced by build.sh and deploy.sh.
# Every value uses "${VAR:-default}" so you can override per-run:
#   PROJECT_ID=my-project ./deploy.sh

# --- GCP project / region ---------------------------------------------------
export PROJECT_ID="${PROJECT_ID:-labs-gcp-msls-16495-1782829337}"
export REGION="${REGION:-us-east1}"

# --- Portal image / service -------------------------------------------------
export ARTIFACT_REGISTRY="${ARTIFACT_REGISTRY:-akapal-geap-chat-portal}"
export SERVICE_NAME="${SERVICE_NAME:-akapal-geap-chat-portal}"

# --- BFF --------------------------------------------------------------------
# Base URL of the BFF service the portal forwards chat turns to. Point this at
# the deployed BFF, not localhost, when deploying.
export BFF_URL="${BFF_URL:-http://localhost:4000}"
